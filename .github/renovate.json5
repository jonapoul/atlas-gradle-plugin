{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>jonapoul/renovate-config:default.json5",
  ],
  "labels": [
    "dependencies"
  ],
  "customManagers": [
    {
      // config/d2.version holds nothing but the version. It feeds both the version Atlas downloads by default and
      // docker/Dockerfile.
      "customType": "regex",
      "managerFilePatterns": [
        "/^config/d2\\.version$/",
      ],
      "matchStrings": [
        "^(?<currentValue>\\S+)\\s*$",
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "terrastruct/d2",
    },
  ],
  "packageRules": [
    {
      // The gradle image is used by both docker/Dockerfile and the container in release.yml, which are handled by
      // different managers. Group them so the two references can't drift apart. Schedule is set explicitly here to
      // override the default github-actions rule, otherwise the group would have two conflicting schedules
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "gradle"
      ],
      "groupName": "gradle docker image",
      "schedule": [
        "at any time"
      ]
    }
  ]
}
